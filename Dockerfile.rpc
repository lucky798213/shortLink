FROM golang:1.24-alpine AS builder
WORKDIR /app
# 国内服务器构建时默认走 goproxy.cn，可用 --build-arg GOPROXY=... 覆盖
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /rpc-server ./cmd/rpc

FROM alpine:3.21
COPY --from=builder /rpc-server /usr/local/bin/rpc-server
COPY configs/rpc.yaml /etc/short_url/rpc.yaml
CMD ["rpc-server"]
